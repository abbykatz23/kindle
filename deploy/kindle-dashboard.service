# Runs the Flask app (web UI, /tap endpoint, and the in-process APScheduler that
# refreshes + pushes the dashboard every 30 min) as a persistent service.
#
# Install on the Pi:
#   sudo cp deploy/kindle-dashboard.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now kindle-dashboard.service
#
# --workers 1 is required: the refresh scheduler starts inside the Flask app
# itself (web/app.py), so more than one gunicorn worker would run it multiple
# times in parallel and push to the Kindle redundantly.

[Unit]
Description=Kindle Dashboard (Flask web UI + refresh scheduler)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/kindle-dashboard
ExecStart=/home/pi/kindle-dashboard/.venv/bin/gunicorn --workers 1 --bind 0.0.0.0:5000 run:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
