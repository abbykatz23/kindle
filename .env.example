# Kindle
KINDLE_HOST=192.168.0.53
KINDLE_USER=root
KINDLE_PASSWORD=

# This machine's own LAN IP — where the Kindle sends tap coordinates.
# Used only by kindle/deploy_tap_listener.sh; update + redeploy whenever
# this host's IP changes.
DASHBOARD_HOST_IP=

# Claude / Anthropic
ANTHROPIC_API_KEY=

# Cloudflare Access (owner detection for the tunnel; see DEPLOY.md section 6)
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Flask
SECRET_KEY=change-me-in-production
FLASK_DEBUG=false
