# Kindle Dashboard — Pi crontab
#
# NOT installed by default. The refresh job below is superseded by the
# in-process APScheduler started in web/app.py (runs every 30 min, plus once
# immediately on service startup) — see deploy/kindle-dashboard.service, which
# is the supported way to keep this running across reboots/power loss.
#
# Only install this file if you are running scheduler/poller.py standalone
# WITHOUT the Flask service running. Installing both will double-push to the
# Kindle on overlapping ticks.
#
# Install with: crontab cron/crontab.example
# Assumes project lives at /home/pi/kindle-dashboard

PROJECT=/home/pi/kindle-dashboard
PYTHON=/home/pi/kindle-dashboard/.venv/bin/python
LOG=/home/pi/kindle-dashboard/logs/cron.log

# Every hour on the hour: poll APIs, re-render, push to Kindle
0 * * * * cd $PROJECT && $PYTHON scheduler/poller.py >> $LOG 2>&1

# NOTE: scheduler/generate_week.py does not exist yet (planned — see
# integrations/claude_api.py). Do not enable this line until it's written,
# or cron will error every Sunday.
# 0 6 * * 0 cd $PROJECT && $PYTHON scheduler/generate_week.py >> $LOG 2>&1
